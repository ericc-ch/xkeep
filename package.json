{
  "name": "xkeep",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "nub run typecheck && nub run test && nub run lint",
    "format": "oxfmt",
    "lint": "oxlint --fix",
    "prepare": "effect-language-service patch && nub scripts/references.ts",
    "start": "nub run --filter @xkeep/server start",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@effect/platform-node": "^4.0.0-rc.112",
    "effect": "^4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.1",
    "@types/node": "^24.10.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.8.2",
      "onFail": "ignore"
    }
  },
  "patchedDependencies": {
    "drizzle-orm@1.0.0-rc.4": "patches/drizzle-orm@1.0.0-rc.4.patch"
  }
}
