{
  "name": "x-bookmarks",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "check": "nub run typecheck && nub run test && nub run lint",
    "format": "oxfmt",
    "lint": "oxlint --fix",
    "prepare": "effect-language-service patch && nub scripts/references.ts",
    "start": "nub run --filter @x-bookmarks/server start",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@effect/platform-node": "^4.0.0-beta.102",
    "effect": "^4.0.0-beta.102"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.1",
    "@types/node": "^24.10.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "^0.8.2",
      "onFail": "ignore"
    }
  }
}
