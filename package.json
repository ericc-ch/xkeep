{
  "name": "x-bookmarks",
  "version": "0.0.0",
  "private": true,
  "bin": {
    "x-bookmarks": "./src/main.ts"
  },
  "type": "module",
  "scripts": {
    "check": "bun run typecheck && bun run test && bun run lint",
    "format": "oxfmt",
    "lint": "oxlint --fix",
    "prepare": "simple-git-hooks && effect-language-service patch && bun scripts/references.ts",
    "start": "bun src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@effect/platform-node": "^4.0.0-beta.102",
    "effect": "^4.0.0-beta.102"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.1",
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run check"
  },
  "packageManager": "bun@1.3.14"
}
